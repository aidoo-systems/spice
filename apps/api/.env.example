# Model — omit OPENAI_API_KEY to run in demo mode (canned plans, streamed).
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# Any OpenAI-compatible endpoint, e.g. a local Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=

# Cost and abuse controls
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=3600
DAILY_LLM_CAP=1000
# How many reverse proxies in front of the API append to X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Or name a header your edge proxy overwrites with the client IP (e.g. cf-connecting-ip).
# CLIENT_IP_HEADER=

LOG_LEVEL=info
